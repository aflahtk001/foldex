{
  "name": "foldex",
  "productName": "Foldex",
  "version": "1.0.0",
  "description": "Foldex - Fast file conversion and compression directly from Windows File Explorer",
  "main": "dist-electron/main/index.js",
  "author": "Foldex",
  "license": "MIT",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && powershell -Command \"Copy-Item src/main/services/getExplorerSelection.ps1 dist-electron/main/services/ -Force\"",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.foldex.app",
    "productName": "Foldex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "src/main/services/getExplorerSelection.ps1",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.12",
    "bmp-js": "^0.1.0",
    "lucide-react": "^1.60.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
